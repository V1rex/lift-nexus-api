atus and result of a previously submitted optimization job.","operationId":"getJobStatus","parameters":[{"name":"jobId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Job status retrieved","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DispatchJobResponse"}}}},"404":{"description":"Job not found"}}},"delete":{"tags":["Dispatcher"],"summary":"Terminate an optimization job","description":"Aborts a running or queued optimization job. Jobs that have already completed will remain in COMPLETED state.","operationId":"terminateJob","parameters":[{"name":"jobId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Job terminated"},"404":{"description":"Job not found"}}}}},"components":{"schemas":{"TransportOrderStatusUpdateRequest":{"type":"object","description":"Request payload for updating the status of a transport order","properties":{"status":{"type":"string","description":"New status for the transport order","enum":["OPEN","ASSIGNED","IN_PROGRESS","COMPLETED","FAILED"],"example":"IN_PROGRESS"}},"required":["status"]},"TransportOrderResponse":{"type":"object","description":"Detailed view of a transport order","properties":{"id":{"type":"integer","format":"int64","description":"Unique identifier","example":1},"trackingCode":{"type":"string","description":"Tracking code of the referenced load unit","example":"LU-2024-001"},"targetLoadUnitId":{"type":"integer","format":"int64","description":"ID of the load unit being transported","example":1},"targetBinId":{"type":"integer","format":"int64","description":"ID of the destination storage bin","example":12},"sourceBinId":{"type":"integer","format":"int64","description":"ID of the source/pickup storage bin","example":5},"requiredEquipment":{"type":"string","description":"Required equipment type","enum":["PALLET_JACK","STANDARD","REACH_TRUCK","SIDE_LOADER"]},"status":{"type":"string","description":"Current